<https://www.ufrgs.br/tesauros/index.php/thesa/c/103633> a skos:Concept ;
    skos:broader <https://www.ufrgs.br/tesauros/index.php/thesa/c/103653> ;
    skos:definition "Área da Organização e Representação do Conhecimento e da Informação dedicada à descrição dos atributos físicos e de conteúdo dos recursos informacionais, por meio de elementos descritivos que possibilitam sua identificação, organização, acesso e recuperação."@pt ;
    skos:inScheme <https://www.ufrgs.br/tesauros/index.php/thesa/terms/1820> ;
    skos:narrower <https://www.ufrgs.br/tesauros/index.php/thesa/c/103635>,
        <https://www.ufrgs.br/tesauros/index.php/thesa/c/103636>,
        <https://www.ufrgs.br/tesauros/index.php/thesa/c/103637> ;

        <https://www.ufrgs.br/tesauros/index.php/thesa/c/103721> ;
    skos:prefLabel "Ontologia"@pt ;
    skos:related <https://www.ufrgs.br/tesauros/index.php/thesa/c/103758> .

<https://www.ufrgs.br/tesauros/index.php/thesa/c/103730> a skos:Concept ;
    skos:broader <https://www.ufrgs.br/tesauros/index.php/thesa/c/103653> ;
    skos:definition "Processo de tratamento da informação e do conhecimento que consiste na organização sistemática de conceitos e suas relações, segundo características e significados, visando à construção de estruturas conceituais coerentes."@pt ;
    skos:inScheme <https://www.ufrgs.br/tesauros/index.php/thesa/terms/1820> ;
    skos:narrower <https://www.ufrgs.br/tesauros/index.php/thesa/c/103731>,
        <https://www.ufrgs.br/tesauros/index.php/thesa/c/103739> ;
    skos:prefLabel "Estruturação Semântica"@pt .

<https://www.ufrgs.br/tesauros/index.php/thesa/c/103747> a skos:Concept ;
    skos:broader <https://www.ufrgs.br/tesauros/index.php/thesa/c/103787> ;
    skos:definition "Âmbito de organização do conhecimento que compreende as unidades conceituais e os elementos constitutivos dos assuntos, considerando suas características, composição e relações na estruturação de domínios do conhecimento."@pt ;
    skos:inScheme <https://www.ufrgs.br/tesauros/index.php/thesa/terms/1820> ;

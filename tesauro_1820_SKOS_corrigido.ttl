        <https://www.ufrgs.br/tesauros/index.php/thesa/c/103725> ;
    skos:prefLabel "Sistema de Classificação Bibliográfica"@pt ;
    skos:related <https://www.ufrgs.br/tesauros/index.php/thesa/c/103636>,
        <https://www.ufrgs.br/tesauros/index.php/thesa/c/103637>,

        <https://www.ufrgs.br/tesauros/index.php/thesa/c/103737> .

<https://www.ufrgs.br/tesauros/index.php/thesa/c/103866> a skos:Concept ;
    skos:broader <https://www.ufrgs.br/tesauros/index.php/thesa/c/103787> ;
    skos:definition "Processo de circulação e transferência de informações entre agentes, sistemas ou ambientes informacionais, compreendendo operações de entrada e saída de dados e informações, mediante mecanismos de comunicação, processamento e compartilhamento."@pt ;
    skos:inScheme <https://www.ufrgs.br/tesauros/index.php/thesa/terms/1820> ;
    skos:narrower <https://www.ufrgs.br/tesauros/index.php/thesa/c/103867> ;
    skos:prefLabel "Fluxo Informacional"@pt ;
    skos:related <https://www.ufrgs.br/tesauros/index.php/thesa/c/103747>,
